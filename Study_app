### notes/notes_screen.dart (simple list + PDF viewer)
```dart
import 'package:flutter/material.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:pdfx/pdfx.dart';

class NotesScreen extends StatelessWidget {
  const NotesScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final notesCol = FirebaseFirestore.instance.collection('notes');

    return Scaffold(
      appBar: AppBar(title: const Text('Notes')),
      body: StreamBuilder<QuerySnapshot>(
        stream: notesCol.snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
          final docs = snapshot.data!.docs;
          return ListView.builder(
            itemCount: docs.length,
            itemBuilder: (context, i) {
              final data = docs[i].data() as Map<String, dynamic>;
              return ListTile(
                title: Text(data['title'] ?? 'Untitled'),
                subtitle: Text(data['description'] ?? ''),
                onTap: () async {
                  final url = data['pdfUrl'];
                  if (url != null) {
                    final doc = await PdfDocument.openData(Uri.parse(url).resolve('').readAsBytes());
                    Navigator.push(context, MaterialPageRoute(builder: (_) => PdfViewPage(document: doc)));
                  }
                },
              );
            },
          );
        },
      ),
    );
  }
}

class PdfViewPage extends StatelessWidget {
  final PdfDocument document;
  const PdfViewPage({super.key, required this.document});

  @override
  Widget build(BuildContext context) {
    final controller = PdfController(document: document);
    return Scaffold(
      appBar: AppBar(title: const Text('PDF')),
      body: PdfView(controller: controller),
    );
  }
}
```

> **Note:** Above code shows how to fetch note metadata from Firestore. For real apps, store signed URLs from Firebase Storage.

